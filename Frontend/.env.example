# ─────────────────────────────────────────────────────────────
#  A-Quire Frontend — Environment Variables Template
#  Copy this file to .env and fill in real values.
#
#  IMPORTANT: Vite bakes these into the built JS bundle at BUILD TIME, not
#  read at runtime — unlike the backend's .env. Changing VITE_API_URL (or
#  anything else here) after `npm run build` requires rebuilding, not just
#  restarting a server.
# ─────────────────────────────────────────────────────────────

# ── Backend API ──────────────────────────────────────────────
# The deployed backend's public URL, including the /api/v1 prefix. The
# WebSocket notifications channel (services/api.js's connectNotifications,
# hooks/useNotificationsWS.js) derives its ws:// / wss:// URL from this
# same value — don't set a separate WS-specific var, there isn't one.
VITE_API_URL=http://localhost:8000/api/v1

# ── Firebase (Google / phone sign-in, ID token verification) ───
# These are Firebase's public WEB config values — safe to expose in a
# client bundle by design (Firebase protects access via its own security
# rules and authorized-domains list, not by keeping these secret). Get them
# from Firebase Console → Project Settings → General → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Optional ──────────────────────────────────────────────────
# Verbose [gaze] console.debug logging (per-frame timing, which MediaPipe
# delegate initialized). Leave false/unset in production.
VITE_GAZE_DEBUG_LOGS=false

# JaaS (Jitsi as a Service, 8x8.vc) App ID for the live meeting room
# feature (pages/MeetingRoom.jsx, routed at /meeting/:roomId). Without a
# real one, that page falls back to a literal placeholder string
# ('vpaas-magic-cookie-YOUR_APP_ID_HERE') and meetings won't work. Only
# needed if you actually use that feature — get one from the 8x8 JaaS
# Developer Console (https://jaas.8x8.vc/).
VITE_JAAS_APP_ID=

# Override for the legacy gaze fallback's face-landmarker model URL — leave
# unset to use the built-in default (utils/legacyGazeTracker.js).
VITE_LEGACY_FACE_LANDMARKER_MODEL_URL=
