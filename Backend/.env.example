# ─────────────────────────────────────────────────────────────
#  A-Quire Backend — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  SECURITY: Never commit .env with real secrets.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME="A-Quire Backend"
API_V1_PREFIX="/api/v1"
# IMPORTANT: Always False in production!
DEBUG=False
# "development" or "production". Set to "production" to enable the strict
# startup checks in ProductionConfig (app/core/config.py) — refuses to boot
# with a default SECRET_KEY, a localhost CORS origin, or missing Firebase config.
ENVIRONMENT="development"

# ── Database ──────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://aquire:aquire@localhost:5432/aquire_db"

# Only used by docker-compose.yml (Postgres container's own password, and
# substituted into the backend/celery containers' DATABASE_URL) — irrelevant
# if you're pointing DATABASE_URL above at a separately managed Postgres
# instance instead of running docker-compose's own postgres service.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD="replace-with-a-real-random-password"

# ── Redis (Celery background tasks) ───────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── YouTube transcript fetching (optional) ──────────────────────
# Without these, YouTube frequently blocks transcript requests from
# cloud/datacenter IPs (AWS, GCP, Azure) — confirmed directly against a
# real EC2 deployment. Lessons still work fine without a transcript; this
# only affects how well AI-generated questions ground in the actual video
# content. Get credentials from Webshare's "Proxy" tab (not account login).
WEBSHARE_PROXY_USERNAME=""
WEBSHARE_PROXY_PASSWORD=""

# ── Firebase Auth ─────────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
# Store OUTSIDE the repo in production (use Secret Manager / env injection)
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"

# ── Security / JWT ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Must be at least 32 chars. Use a DIFFERENT key per environment.
SECRET_KEY="replace-with-a-64-char-random-hex-string"

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Production example: https://app.a-quire.com
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Reverse proxy ─────────────────────────────────────────────
# Only set True behind a trusted reverse proxy that overwrites (not just
# passes through) X-Forwarded-For with the real client IP — e.g. this
# project's docker-compose.yml + Caddyfile. Unsafe to enable against a
# directly-reachable backend: any client could set that header themselves
# and pick their own rate-limit bucket. See rate_limit.py.
TRUST_X_FORWARDED_FOR=False

# ── AWS Polly (Text-to-Speech for mentor hints) ─────────────────
# Without credentials, hints are generated but not spoken aloud.
AWS_REGION_NAME="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
POLLY_VOICE_ID="Matthew"

# ── Anthropic API (AI Mentor hints + AMATTA question generation) ────────
# Get a key at https://console.anthropic.com/settings/keys
# Without ANTHROPIC_API_KEY, the mentor falls back to static hint templates
# and generator_service falls back to returning None (AMATTA serves only
# from the existing question bank).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_ID="claude-sonnet-5"

# ── AMATTA AI generation rate limits ────────────────────────────
# Master switch; false = never generate, item bank only.
AI_GENERATION_ENABLED=True
# Min acceptable max Fisher information among eligible items before
# falling back to generation (below this, the bank is too uninformative
# at the learner's current theta).
AI_GENERATION_INFO_THRESHOLD=0.05
AI_GENERATION_MAX_PER_SESSION=5
AI_GENERATION_MAX_PER_TOPIC=20
