# ─────────────────────────────────────────────────────────────
#  A-Quire Backend — Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME="A-Quire Backend"
API_V1_PREFIX="/api/v1"
DEBUG=True

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://aquire:aquire@localhost:5432/aquire_db"

# ── Redis (Celery background tasks) ───────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── Firebase Auth ─────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"

# ── Security / JWT ────────────────────────────────────────────
SECRET_KEY="a-quire-super-secret-jwt-key-change-in-production-32chars"

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── AWS Bedrock (AI Mentor) ───────────────────────────────────
# Leave blank to use rich template hints (fallback mode — no AWS needed)
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
